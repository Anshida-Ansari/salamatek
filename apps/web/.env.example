# Salamatek Web — Environment Variables
# Copy this file to .env.local (development) or set these in Vercel dashboard (production).
# ⚠️  Never commit the real .env.local file to version control.

# ─── API ──────────────────────────────────────────────────────────────────────
# Dev:        http://localhost:5000
# Production: https://your-api.onrender.com   (your Render service URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─── Site ─────────────────────────────────────────────────────────────────────
# Used in OpenGraph metadata and sitemap generation
# Dev:        http://localhost:3000
# Production: https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Your Cloudinary cloud name and unsigned upload preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ─── WhatsApp CTA ─────────────────────────────────────────────────────────────
# International format without + (e.g. 966501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=966XXXXXXXXX

# ─── Google Analytics (optional) ──────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
