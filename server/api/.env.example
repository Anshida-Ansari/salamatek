# Salamatek API — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# ⚠️  Never commit the real .env file to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev:       mongodb://localhost:27017/salamatek
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/salamatek?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/salamatek

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here_replace_this
JWT_EXPIRES_IN=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:3000

# ─── Email / SMTP (optional — only needed if you want admin email notifications) ─
# Leave blank to use the development stream (logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
CONTACT_EMAIL_RECIPIENT=info@yourdomain.com
